# --- LLM (used only for discovery; litellm model string) ---
# anthropic/claude-haiku-4-5 + ANTHROPIC_API_KEY
# openai/<model>            + OPENAI_API_KEY
# any OpenAI-compatible proxy: OPERANT_DISCOVERY__MODEL=openai/<model>
#   + OPERANT_DISCOVERY__API_BASE + OPERANT_DISCOVERY__API_KEY
OPERANT_DISCOVERY__MODEL=anthropic/claude-haiku-4-5
# Or route each agent role to its own model, with timeouts and fallbacks,
# through a litellm Router config (overrides the model setting above):
# OPERANT_DISCOVERY__ROUTER_CONFIG=router.yml
ANTHROPIC_API_KEY=

# --- Server / driver ---
# Generated into state/server-token on first start when unset.
OPERANT_SERVER__AUTH_TOKEN=
# Set when the driver daemon runs as a separate process (always, in Docker).
# OPERANT_DRIVER__URL=http://127.0.0.1:7411
OPERANT_DRIVER__AUTH_TOKEN=

# --- Secrets backend: env (default) or keychain ---
OPERANT_SECRETS__BACKEND=env

# --- Target app credentials for the ParaBank demo (demo data only) ---
# Referenced from policies/parabank.json as secret refs; resolved at run
# time by the trusted process and never written to artifacts or logs.
PARABANK_USERNAME=john
PARABANK_PASSWORD=demo

# --- PII scrubbing (optional `privacy` extra; docs/adr/0007) ---
# auto = Presidio when the extra and the spaCy model are installed.
# OPERANT_PRIVACY__SCRUBBER=auto
# OPERANT_PRIVACY__SPACY_MODEL=en_core_web_lg
# exact = known values only (fast); scrubbed = also run Presidio on evidence.
# OPERANT_PRIVACY__EVIDENCE=exact

# --- Model tracing with self-hosted Langfuse (optional; docs/adr/0002) ---
# docker compose --profile observability up -d, then open http://localhost:3000
# OPERANT_OBSERVABILITY__BACKEND=langfuse
# OPERANT_OBSERVABILITY__HOST=http://localhost:3000
# scrubbed = prompts after redaction + PII scrubbing; metadata = no prompts.
# OPERANT_OBSERVABILITY__CONTENT=scrubbed
# Project keys: any pk-lf-/sk-lf- strings you choose; first boot creates them.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
# CHANGEME before exposing beyond localhost (openssl rand -hex 32 for the key).
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
